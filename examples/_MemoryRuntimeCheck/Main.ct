import ObjektRT.std.Memory;
import "../../src/Memory/ManagedPtr.ct";
/// Demonstrates the inline `IL { ... }` block: emits raw VM instructions
/// (must be valid IL for a single expression) directly into the method body.
fn IlAdd() -> int {
    var r = 0;
    IL {
        ldc.i4 20
        ldc.i4 22
        add
        stloc r
    }
    return r;
}

/// Demonstrates the raw pointer opcodes (`ptr.alloc`, `ptr.len`, `ptr.free`)
/// emitted through the `IL { ... }` block.
fn IlPtrLen() -> int {
    var n = 0;
    var h: object = null;
    IL {
        ldc.i4 3        // count
        ldc.i4 4        // element size
        ptr.alloc
        stloc h
        ldloc h
        ptr.len
        stloc n
        ldloc h
        ptr.free
    }
    return n;
}

Contract Program {
    static fn Main() {
        IO.Println("-- managed memory pointers --");

        // ManagedPtr<int> over the host binding (block-backed, bounds-checked)
        var m = new ManagedPtr<int>(4);
        *m = 7;                        // C-style deref: *m == m[0]
        m[1] = 20;
        m[2] = 42;
        IO.Println(*m);                // 7  (deref read == element 0)
        IO.Println(m[0]);              // 7  (indexed read == element 0)
        IO.Println(m[2]);              // 42 (indexed deref write+read)
        m[2] += 8;
        IO.Println(m[2]);              // 50 (compound through indexer)
        IO.Println(m.Count());         // 4
        IO.Println(&m > 0);            // true (address-of -> raw address long)
        m.Free();
        IO.Println(m.IsFreed());       // true

        // Typed read/write: ManagedPtr<T> dispatches on the element type.
        // long (I8, 8 bytes)
        var big = new ManagedPtr<long>(3);
        big[0] = Convert.ToInt64("12345678901");   // 64-bit via parse (no long literals)
        big[1] = big[0] + 1;
        IO.Println("long  big[1] => " + Convert.ToStringL(big[1]));  // 12345678902
        big.Free();

        // float (R4, 4 bytes)
        var f = new ManagedPtr<float>(3);
        f[0] = 0.5;
        IO.Println("float f[0]   => " + Convert.ToStringF(f[0]));     // 0.5
        f[1] = f[0] * 4;
        IO.Println("float f[1]   => " + Convert.ToStringF(f[1]));     // 2
        // f is still addressable & native
        IO.Println("float &f > 0 => " + Convert.ToStringB(&f > 0));   // true
        f.Free();

        // double (R8, 8 bytes)
        var d = new ManagedPtr<double>(2);
        d[0] = 3.25;
        IO.Println("double d[0]  => " + Convert.ToStringD(d[0]));     // 3.25
        d.Free();

        // Raw IL block: constant arithmetic
        IO.Println(IlAdd());

        // Raw IL block: pointer ops
        IO.Println(IlPtrLen());
    }
}
