import ObjektRT.Core;
import __builtin.std;

Contract Program {
    static fn Main() {
        IO.Println("-- shadowed DateTime end-to-end --");
        var dt = new DateTime(2024, 1, 15);
        IO.Println(dt.Year());
        IO.Println(dt.Month());
        IO.Println(dt.Day());
        IO.Println(dt.ToShortDate());
        IO.Println(dt.ToIso()); 
        var d = 10.0;
        var later = dt.AddDays(d);
        IO.Println(later.Day());
        var now = DateTime.Now();
        IO.Println(now.Year());
    }
}